# URL to your Ollama server. If you are running Ollama locally, you can use http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# The LLM_MODEL is the name of the model you want to use. You can find available models by running `ollama list` in your terminal.
LLM_MODEL=qwen2.5:7b

# The user of the postgres db we run with docker compose.
POSTGRES_USER=nodeagent

# The password of the postgres db we run with docker compose.
POSTGRES_PASSWORD=12345678

# The name of the postgres db we run with docker compose.
POSTGRES_DB=nodeagent

# The port of the postgres db we run with docker compose.
POSTGRES_PORT=5432