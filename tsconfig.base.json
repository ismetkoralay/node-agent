{
  "compilerOptions": {
    "strict": true, // Enables the whole strict family: null checks, implicit any, etc.
    "noUncheckedIndexedAccess": true, // arr[i] and record[key] are T | undefined, so out-of-range reads must be handled
    "module": "nodenext", // Match Node's real module system (ESM/CJS decided by package.json "type")
    "moduleResolution": "nodenext", // Resolve imports the way Node does, including explicit file extensions
    "target": "esnext", // Node runs the source directly and tsc never emits, so no downleveling is needed
    "verbatimModuleSyntax": true, // Type-only imports must use `import type`, so Node's type stripping never sees a type as a value
    "erasableSyntaxOnly": true, // Forbids enum, namespace and constructor parameter properties, which Node cannot strip
    "allowImportingTsExtensions": true, // Lets sources import "./types.ts", the path Node actually loads
    "noEmit": true, // tsc only type-checks; Node executes the .ts files itself
    "skipLibCheck": true // Skip type-checking .d.ts files from dependencies to keep checks fast
  }
}
