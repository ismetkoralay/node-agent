{
  "name": "node-agent",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "hello": "node --env-file-if-exists=.env scripts/hello.ts",
    "chat": "node --env-file-if-exists=.env scripts/chat.ts"
  },
  "author": "Ismet Koralay",
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@node-agent/core": "workspace:*",
    "@node-agent/provider-ollama": "workspace:*",
    "@node-agent/tools": "workspace:*"
  }
}
