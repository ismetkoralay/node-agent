# The NODE_ENV to deploy our server. Defaults to development.
NODE_ENV=development

# The port we'll serve our server. Defaults to 3000.
PORT=3000

# Server's log level. Defaults to info.
LOG_LEVEL=info

# URL to your Ollama server. If you are running Ollama locally, you can use http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# The LLM_MODEL is the name of the model you want to use. You can find available models by running `ollama list` in your terminal.
LLM_MODEL=qwen2.5:7b

# The number of max steps an agent can take. Defaults to 8.
AGENT_MAX_STEPS=8